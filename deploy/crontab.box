# Install on the box, as the ubuntu user:  crontab deploy/crontab.box
# (prints nothing on success; output goes to ~/.chhaya/backups/backup.log and export.log)
#
# Nightly backup at 02:00 IST = 20:30 UTC (the box clock is UTC). It stops the stack for
# a few seconds, takes a verified tarball, restarts, then uploads to S3. S3 keeps 30 days
# (lifecycle rule in infra/terraform/s3.tf). docs/decisions.md, 2026-11-09.
PATH=/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CHHAYA_BACKUP_S3=s3://chhaya-backup-803874683069-ap-south-1/backups
30 20 * * * cd /home/ubuntu/chhaya && scripts/dev.sh backup >> /home/ubuntu/.chhaya/backups/backup.log 2>&1

# Trace export at 02:45 IST = 20:45 UTC, after the backup has finished and restarted the
# stack. Builds one trace per recent session from state.db and the audit log and uploads
# them to s3://BUCKET/evals/days/. Separate from the backup on purpose: neither can fail
# the other. docs/observability-and-evals.md. If this line is new on a running box, install
# it with `crontab deploy/crontab.box` (box-setup.sh --cron does too).
45 20 * * * cd /home/ubuntu/chhaya && go build -o bin/chhayactl ./cmd/chhayactl && bin/chhayactl trace export -s3 s3://chhaya-backup-803874683069-ap-south-1/evals >> /home/ubuntu/.chhaya/backups/export.log 2>&1

# Cost of each finished Hermes session, sent to you on Telegram by the approver bot. Every 10
# minutes; a session counts as finished once it is 35 minutes quiet (the idle reset is 30) or
# Hermes ended it. Prices are config/pricing.yaml; what was already sent is remembered in
# ~/.chhaya/gateway/cost-reported.json. If this line is new on a running box, install it with
# `crontab deploy/crontab.box` (box-setup.sh --cron does too).
*/10 * * * * cd /home/ubuntu/chhaya && go build -o bin/chhayactl ./cmd/chhayactl && bin/chhayactl cost report -send -q >> /home/ubuntu/.chhaya/backups/cost.log 2>&1

# The deterministic checks over every session, 5 minutes after the export has uploaded them. Checks
# the IST day that just ended and the new one (the box clock is UTC, so at 20:50 it is 02:20 IST).
# The bucket's copy is read, not a local one. The report goes to check.log; `fail` lines mean an
# invariant broke, `flag` lines mean read the trace. Not yet sent to Telegram (docs/backlog.md).
# `%` must be escaped in a crontab. docs/observability-and-evals.md, "Code checks".
50 20 * * * cd /home/ubuntu/chhaya && for d in $(TZ=Asia/Kolkata date -d yesterday +\%F) $(TZ=Asia/Kolkata date +\%F); do echo "== $d"; bin/chhayactl trace check -s3 s3://chhaya-backup-803874683069-ap-south-1/evals -day $d; done >> /home/ubuntu/.chhaya/backups/check.log 2>&1

# The memory's own tests (fact ids, probes, golden set), 5 minutes after the trace check. A fact
# with no id, a repeated id, or a probe about a fact that is gone is a `fail` in memtest.log.
# Runs no model. The probes and golden set live in ~/.chhaya/gateway/memory/.tests (the memory
# repo, never this one). docs/decisions.md 2026-11-16; docs/dreaming.md, the canary.
55 20 * * * cd /home/ubuntu/chhaya && bin/chhayactl memtest check -memory /home/ubuntu/.chhaya/gateway/memory >> /home/ubuntu/.chhaya/backups/memtest.log 2>&1

# The memory canary: a small model answers every probe and golden question using only the memory
# tools, against a copy of memory. A `MISS` (a fact's line never reached the model) or a golden
# `FAIL` makes the run exit non-zero; the log is memrun.log. About 2.5 minutes and a few cents a
# night (Haiku answers, Sonnet judges; the judge's WRONG lines are informational). Needs
# PROXY_API_KEY in deploy/.env.hermes, which the box already has. docs/decisions.md 2026-11-17.
0 21 * * * cd /home/ubuntu/chhaya && bin/chhayactl memtest run -memory /home/ubuntu/.chhaya/gateway/memory -env-file deploy/.env.hermes -json /home/ubuntu/.chhaya/backups/memrun.json >> /home/ubuntu/.chhaya/backups/memrun.log 2>&1

# The morning report, 07:30 IST = 02:00 UTC: re-runs the trace checks over yesterday and today, the
# memory tests, reads the canary's memrun.json, uploads an HTML report to
# s3://BUCKET/evals/reports/DAY.html and sends you one Telegram message (counts and check names,
# never message text) with a presigned link. The link is signed with the box's role credentials, so
# it lasts about 6 hours: that is why this is the morning, not 02:30. A night with no message at all
# means this job broke. A canary result older than 26 hours shows as FAILED. docs/decisions.md 2026-11-18.
0 2 * * * cd /home/ubuntu/chhaya && go build -o bin/chhayactl ./cmd/chhayactl && bin/chhayactl report nightly -s3 s3://chhaya-backup-803874683069-ap-south-1/evals -memory /home/ubuntu/.chhaya/gateway/memory -run-json /home/ubuntu/.chhaya/backups/memrun.json -env deploy/.env.gateway -send >> /home/ubuntu/.chhaya/backups/report.log 2>&1
