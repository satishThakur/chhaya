# The health module's secrets. Created by `scripts/dev.sh health-init`, which fills the two
# generated values; you fill the Garmin login. NEVER copy any of this into .env.hermes: the ingest
# secret is the only thing that lets anything write health data, and Hermes must not hold it.
# (scripts/dev.sh refuses to start if .env.hermes mentions either name.)

# The TimescaleDB password. Generated.
HEALTH_DB_PASSWORD=

# The shared secret between the sync and the gateway's ingest listener. Generated.
CHHAYA_HEALTH_INGEST_SECRET=

# Your Garmin Connect login (username and password, no two-factor). Fill these on the DESKTOP only:
# Garmin refuses sign-ins from AWS. On the box leave both empty: it has no sync container and gets
# the data from S3 (chhayactl health pull).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Desktop only. Where the sync writes instead of posting to the gateway, and the put-only key it
# uses (infra/terraform/health.tf). With HEALTH_S3_URI set the gateway secret is not used by the sync.
# HEALTH_S3_URI=s3://chhaya-backup-ACCOUNT-ap-south-1/health/inbox
# HEALTH_AWS_ACCESS_KEY_ID=
# HEALTH_AWS_SECRET_ACCESS_KEY=
# HEALTH_AWS_REGION=ap-south-1

# Optional. IANA zone whose midnight starts a day (default Asia/Kolkata) and the minutes between
# syncs (default 180).
# CHHAYA_HEALTH_TZ=Asia/Kolkata
# SYNC_EVERY_MINUTES=180
