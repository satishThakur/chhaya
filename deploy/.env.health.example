# The health module's secrets. Created by `scripts/dev.sh health-init`, which fills the two
# generated values; you fill the Garmin login. NEVER copy any of this into .env.hermes: the ingest
# secret is the only thing that lets anything write health data, and Hermes must not hold it.
# (scripts/dev.sh refuses to start if .env.hermes mentions either name.)

# The TimescaleDB password. Generated.
HEALTH_DB_PASSWORD=

# The shared secret between the sync and the gateway's ingest listener. Generated.
CHHAYA_HEALTH_INGEST_SECRET=

# Your Garmin Connect login (username and password, no two-factor).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional. IANA zone whose midnight starts a day (default Asia/Kolkata) and the minutes between
# syncs (default 180).
# CHHAYA_HEALTH_TZ=Asia/Kolkata
# SYNC_EVERY_MINUTES=180
