# The gateway's environment. Mounted into the gateway container ONLY.
#
# Hermes must never be able to read this file. If the approver token ever
# reaches Hermes, the agent can forge its own approvals and the entire
# safety model is void. See docs/decisions.md, "The kill switch lives on
# the approver bot".

# Telegram bot that carries approvals and /stop (BotFather bot #2)
CHHAYA_APPROVER_BOT_TOKEN=

# Your numeric Telegram user ID — the only person whose taps count.
CHHAYA_APPROVER_ALLOWED_USERS=

# Downstream credentials. The gateway holds these; Hermes never sees them.
SWIGGY_OAUTH_CLIENT_ID=
SWIGGY_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN=
GARMIN_USERNAME=
GARMIN_PASSWORD=
