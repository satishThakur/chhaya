# Hermes' environment. Mounted into the Hermes container ONLY.
#
# This file must NEVER contain the approver bot token, any Swiggy/GitHub/
# Garmin credential, or the gateway's private key. Hermes holds exactly one
# secret: the token for its own Telegram bot. Everything else reaches it
# through the gateway, or not at all.

# Which environment this machine is: dev or prod, exactly. There is no default.
# Must match CHHAYA_ENV in .env.gateway. Preflight asks Telegram who each bot token
# is and refuses to start if the bots do not belong to this environment, because two
# machines polling one bot drop messages and misroute approvals.
#   prod bots: chhaya_bot, chhaya_approver_bot
#   dev bots:  chhaya_dev_bot, chhaya_dev_approver_bot  (usernames contain "_dev_")
CHHAYA_ENV=

# Telegram bot that Hermes talks to you on (BotFather bot #1)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. With no allowlist, Hermes denies everyone.
TELEGRAM_ALLOWED_USERS=

# Model provider for the agent loop. The design's end state points this at our
# own logging proxy so every LLM call is traced; M0b does not include the proxy,
# so for a live smoke test point it at a provider directly and accept no traces.
#
# Not secrets — they live here only to sit beside the key they pair with.
CHHAYA_HERMES_MODEL=claude-sonnet-5
CHHAYA_HERMES_API_BASE=https://api.anthropic.com/v1

# The API key for the above. Named PROXY_API_KEY because config.yaml reads it
# through `key_env: PROXY_API_KEY`, whichever endpoint it is pointed at.
PROXY_API_KEY=
