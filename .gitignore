# --- secrets: never commit ---
# Real env files. Only *.example templates are tracked.
.env
.env.*
!.env.*.example
*.pem
*.key
*.crt
*.p12
certs/
secrets/

# --- runtime state ---
# Personal memory IS tracked (it's the asset). These are not.
audit/*.log
audit/*.jsonl
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
hermes-data/

# --- go ---
# Compiled binaries. `go build ./cmd/...` drops them in the repo root.
/chhayad
/chhayactl
/bin/
*.test
*.out
coverage.*

# --- editors / os ---
.DS_Store
*.swp
.idea/
.vscode/
