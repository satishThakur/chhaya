# --- secrets: never commit ---
# Real env files. Only *.example templates are tracked.
.env
.env.*
!.env.*.example
*.pem
*.key
*.crt
*.p12
certs/
secrets/
# Rendered from hermes/config.yaml at `make dev-up`; carries no secret itself but
# is environment-specific and regenerated every start.
deploy/.hermes-config.rendered.yaml

# --- runtime state ---
# Personal memory is DATA and lives outside the repo (~/.chhaya/gateway/memory, its
# own local git repo). This repo is public: anything under memory/ must never be
# committed, so a stray one is ignored outright. memory.example/ is the generic seed.
memory/
audit/*.log
audit/*.jsonl
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
hermes-data/

# --- go ---
# Compiled binaries. `go build ./cmd/...` drops them in the repo root.
/chhayad
/chhayactl
/bin/
*.test
*.out
coverage.*

# --- editors / os ---
.DS_Store
*.swp
.idea/
.vscode/
