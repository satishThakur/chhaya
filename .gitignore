# --- secrets: never commit ---
# Real env files. Only *.example templates are tracked.
.env
.env.*
!.env.*.example
*.pem
*.key
*.crt
*.p12
certs/
secrets/
# Rendered from hermes/config.yaml at `make dev-up`; carries no secret itself but
# is environment-specific and regenerated every start.
deploy/.hermes-config.rendered.yaml

# --- runtime state ---
# Personal memory IS tracked (it's the asset). These are not.
# Staged memory proposals: generated, reviewed, then applied or dropped.
memory/.proposals/
audit/*.log
audit/*.jsonl
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
hermes-data/

# --- go ---
# Compiled binaries. `go build ./cmd/...` drops them in the repo root.
/chhayad
/chhayactl
/bin/
*.test
*.out
coverage.*

# --- editors / os ---
.DS_Store
*.swp
.idea/
.vscode/
